---
import config from 'virtual:starlight/user-config';
import mark from '../assets/mark.svg?raw';

const href = import.meta.env.BASE_URL;
---

<a href={href} class="halo-title" aria-label={config.title.en ?? 'HALO'}>
	<span class="halo-mark" set:html={mark} />
	<span class="halo-name">HALO</span>
	<span class="halo-sub">Always-On Intelligence docs</span>
</a>

<style>
	.halo-title {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		text-decoration: none;
		color: var(--sl-color-white);
		white-space: nowrap;
	}
	.halo-mark {
		display: inline-flex;
		width: 1.35rem;
		height: 1.35rem;
	}
	.halo-mark :global(svg) {
		width: 100%;
		height: 100%;
	}
	.halo-name {
		font-family: var(--halo-display);
		font-weight: 600;
		font-size: 1.12rem;
		letter-spacing: -0.01em;
	}
	.halo-sub {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		margin-top: 0.15rem;
	}
	@media (max-width: 30rem) {
		.halo-sub {
			display: none;
		}
	}
</style>
