---
// The pipeline of one of HALO's survey modes, as a row of steps.
interface Props {
	mode: 'read' | 'run';
	lang?: 'en' | 'zh';
}
const { mode, lang = 'en' } = Astro.props;
const zh = lang === 'zh';
const steps = {
	read: zh
		? [
				['资料', '论文、产品文档和代码，固定版本'],
				['三个监督智能体', 'GPT-6-Astra、Claude Opus 5.5、Claude Fable 5.1，各自独立阅读'],
				['逐格判断', '每条通路和每个证据步骤给出标签、原文引用和位置'],
				['多数投票', '三票中的多数决定每一格'],
				['表格', '40 项工作的通路与证据'],
			]
		: [
				['Sources', 'papers, product documentation, and code, at pinned versions'],
				['Three oversight agents', 'GPT-6-Astra, Claude Opus 5.5, and Claude Fable 5.1, each reading alone'],
				['A label per cell', 'every channel and evidence step, with a quote and a locator'],
				['Majority vote', 'two of three agents decide each cell'],
				['Table', 'channels and evidence for 40 works'],
			],
	run: zh
		? [
				['发布的代码', '只替换模型客户端，适配器声明切断点'],
				['原始运行', '固定输入和固定的基座模型'],
				['切断运行', '去掉一条或几条通路或证据步骤，其余不变'],
				['盲评', '评审模型不知道输出来自哪一组'],
				['报告', '哪些切断改变了输出'],
			]
		: [
				['Released code', 'only the model clients are replaced, and an adapter declares the cut sites'],
				['Original run', 'fixed inputs and one fixed backbone'],
				['Cut runs', 'one or more channels or evidence steps removed, everything else kept'],
				['Blind judge', 'compares outputs without knowing which run they came from'],
				['Report', 'which cuts changed the output'],
			],
}[mode];
---

<figure class="pipeline not-content">
	<ol>
		{
			steps.map(([title, text], i) => (
				<li>
					<span class="n">{i + 1}</span>
					<strong>{title}</strong>
					<span class="t">{text}</span>
				</li>
			))
		}
	</ol>
</figure>

<style>
	.pipeline {
		margin: 1.5rem 0;
	}
	ol {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0;
		list-style: none;
		padding: 0;
		margin: 0;
		border: 1px solid var(--halo-line);
		border-radius: 8px;
		overflow: hidden;
	}
	li {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 0.9rem 0.9rem 1rem;
		border-right: 1px solid var(--halo-line);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	li:last-child {
		border-right: 0;
	}
	li:not(:last-child)::after {
		content: '→';
		position: absolute;
		right: -0.45rem;
		top: 0.85rem;
		background: var(--sl-color-black);
		color: var(--sl-color-gray-3);
		font-size: 0.8rem;
		line-height: 1;
		z-index: 1;
	}
	.n {
		font-family: var(--sl-font-mono);
		color: var(--sl-color-gray-4);
	}
	strong {
		font-family: var(--halo-display);
		font-weight: 500;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
	}
	@media (max-width: 50rem) {
		ol {
			grid-template-columns: 1fr;
		}
		li {
			border-right: 0;
			border-bottom: 1px solid var(--halo-line);
		}
		li:last-child {
			border-bottom: 0;
		}
		li:not(:last-child)::after {
			display: none;
		}
	}
</style>
