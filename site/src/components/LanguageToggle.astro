---
// A link to the same page in the other language, in place of Starlight's language select.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const rest = path.startsWith(base) ? path.slice(base.length) || '/' : path;
const isZh = rest === '/zh-cn' || rest.startsWith('/zh-cn/');
const target = isZh ? base + (rest.slice('/zh-cn'.length) || '/') : `${base}/zh-cn${rest}`;
---

<a class="halo-lang" href={target} hreflang={isZh ? 'en' : 'zh-CN'} lang={isZh ? 'en' : 'zh-CN'} title={isZh ? 'English' : '简体中文'}>
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="12" r="9" />
		<path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" />
	</svg>
	<span>{isZh ? 'EN' : '中文'}</span>
</a>

<style>
	.halo-lang {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		height: 2rem;
		padding: 0 0.5rem;
		border-radius: 6px;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		text-decoration: none;
	}
	.halo-lang:hover,
	.halo-lang:focus-visible {
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
	}
	.halo-lang svg {
		width: 1rem;
		height: 1rem;
	}
</style>
